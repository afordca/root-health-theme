{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign criteria_label = section.settings.criteria_label
  assign background_image = section.settings.background_image
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
-%}

{{ 'section-root-health-selection-process.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
{% endstyle %}

<section
  class="root-health-section root-health-selection-process section-{{ section.id }}-padding"
  id="root-health-selection-process-{{ section.id }}"
>
  <div class="root-health-section__container root-health-selection-process__container">
    {% if background_image %}
      {%- liquid
        assign sizes = '(min-width: 768px) 450px, 400px'
      -%}
      {{
        background_image
        | image_url: width: 450
        | image_tag:
          sizes: sizes,
          widths: '400, 450',
          class: 'root-health-selection-process__background',
          loading: 'lazy',
          alt: background_image.alt
        | default: heading
      }}
    {% else %}
      <img
        src="{{ 'selection-process-bg.jpg' | asset_url }}"
        class="root-health-selection-process__background"
        width="450"
        height="450"
        loading="lazy"
        alt="{{ heading }}"
        sizes="(min-width: 768px) 450px, 400px"
      >
    {% endif %}

    <div class="root-health-selection-process__content">
      {% if heading != blank %}
        <h2 class="root-health-selection-process__heading">{{ heading }}</h2>
      {% endif %}

      {% if description != blank %}
        <p class="root-health-selection-process__description">{{ description }}</p>
      {% endif %}

      {% if criteria_label != blank %}
        <p class="root-health-selection-process__criteria-label type-label">{{ criteria_label }}</p>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="root-health-selection-process__criteria-grid">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'criteria_item' %}
                {% if block.settings.text != blank %}
                  <div class="root-health-selection-process__criteria-item" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Health Select",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "criteria_label",
      "label": "Criteria label"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Recommended size: 450x450px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "criteria_item",
      "name": "Criteria Item",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Criteria text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Health Selection Process",
      "settings": {
        "heading": "We implemented a rigorous selection process for our ingredients",
        "description": "We spent over two years developing, modifying, testing and formulating our product. Every ingredient was picked with purpose and intent. Learn the benefits of each ingredient.",
        "criteria_label": "Criteria"
      },
      "blocks": [
        {
          "type": "criteria_item",
          "settings": {
            "text": "Non-GMO\nLead Free"
          }
        },
        {
          "type": "criteria_item",
          "settings": {
            "text": "Clean Label\nNo Additives"
          }
        },
        {
          "type": "criteria_item",
          "settings": {
            "text": "Third-Party\nTested"
          }
        },
        {
          "type": "criteria_item",
          "settings": {
            "text": "Research\nBacked"
          }
        }
      ]
    }
  ]
}
{% endschema %}

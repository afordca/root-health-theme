{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
  assign background_image = section.settings.background_image
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
-%}

{{ 'section-root-helps-shipped.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
{% endstyle %}

<section
  class="root-helps-section root-helps-shipped section-{{ section.id }}-padding"
  id="root-helps-shipped-{{ section.id }}"
>
  <div class="root-helps-section__container root-helps-shipped__container">
    {% if background_image %}
      {%- liquid
        assign sizes = '(min-width: 768px) 600px, 400px'
      -%}
      {{
        background_image
        | image_url: width: 600
        | image_tag:
          sizes: sizes,
          widths: '400, 600',
          class: 'root-helps-shipped__background',
          loading: 'lazy',
          alt: background_image.alt
        | default: heading
      }}
    {% else %}
      <img
        src="{{ 'shipped-bg.jpg' | asset_url }}"
        class="root-helps-shipped__background"
        width="600"
        height="778"
        loading="lazy"
        alt="{{ heading }}"
        sizes="(min-width: 768px) 600px, 400px"
      >
    {% endif %}

    <div class="root-helps-shipped__content">
      {% if heading != blank %}
        <h2 class="root-helps-shipped__heading">{{ heading }}</h2>
      {% endif %}

      {% if description != blank %}
        <p class="root-helps-shipped__description">{{ description }}</p>
      {% endif %}

      {% if button_text != blank and button_url != blank %}
        <button class="root-helps-shipped__button">
          <a href="{{ button_url }}" aria-describedby="root-helps-shipped-{{ section.id }}">
            {{ button_text }}
          </a>
        </button>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Helps Shipped",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Recommended size: 600x778px for desktop, 400x519px for mobile"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Root Helps Shipped",
      "settings": {
        "heading": "We ship directly to your door every month.",
        "description": "Anything we can do to make your life easier. We're all about convenience",
        "button_text": "SUBSCRIBE NOW",
        "button_url": "#"
      }
    }
  ]
}
{% endschema %}

{% comment %}
  CTA - Blenders Section

  A call-to-action section promoting grab-and-go products as an alternative to powders and blenders.
  Features a background image with right-aligned content including heading, subtext, and CTA button.
{% endcomment %}

{{ 'section-root-health-cta-blenders.css' | asset_url | stylesheet_tag }}

<section
  class="root-health-section root-health-cta-blenders"
  id="RootHelpsCTABlenders-{{ section.id }}"
  style="--section-height: {{ section.settings.section_height }}px;  --heading-color: {{ section.settings.heading_color }}; --subtext-color: {{ section.settings.subtext_color }}; --button-bg-color: {{ section.settings.button_bg_color }}; --button-text-color: {{ section.settings.button_text_color }};"
>
  <div class="root-health-section__container">
    {%- if section.settings.background_image != blank -%}
      {% assign background_image = section.settings.background_image | image_url %}
    {%- else -%}
      {% assign background_image = 'cta-blenders-bg-682b75.jpg' | asset_url %}
    {%- endif -%}
    <div
      class="root-health-cta-blenders__container"
      style="background-image: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(0,0,0,0.5) 75%), url('{{ background_image }}');"
    >
      <div
        class="root-health-cta-blenders__background-image"
      >
        <img
          src="{{ background_image }}"
          alt="{{ section.settings.heading }}"
          height=""
          width=""
        >
      </div>
      <div class="root-health-cta-blenders__content-wrapper">
        <div class="root-health-cta-blenders__content">
          {% if section.settings.heading != blank %}
            <h2 class="root-health-cta-blenders__heading">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.subtext != blank %}
            <p class="root-health-cta-blenders__subtext">
              {{ section.settings.subtext }}
            </p>
          {% endif %}

          {% if section.settings.button_text != blank and section.settings.button_url != blank %}
            <a
              href="{{ section.settings.button_url }}"
              class="root-health-cta-blenders__button__link root-health-cta-blenders__button"
              {% if section.settings.button_url contains 'http' %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              {{ section.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Health CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Recommended size: 1380x960px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who has time for powders or blenders?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Just grab and go and focus on what's important instead."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (px)",
      "min": 672,
      "max": 1248,
      "step": 96,
      "default": 960
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding (px)",
      "min": 20,
      "max": 80,
      "step": 10,
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#E5653D"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#FC4C44"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Root Health CTA Blenders"
    }
  ]
}
{% endschema %}

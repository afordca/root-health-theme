{% comment %}
  Root Helps - Values Section
  Grid layout showcasing company values with titles and descriptions
{% endcomment %}

{{ 'section-root-helps-values.css' | asset_url | stylesheet_tag }}

<section
  class="root-helps-section root-helps-values"
  style="
    --values-padding-top: {{ section.settings.padding_top }}px;
    --values-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="root-helps-section__container root-helps-values__container">
    {%- if section.settings.subtitle != blank -%}
      <div class="root-helps-values__header">
        <h2 class="root-helps-values__subtitle">{{ section.settings.subtitle | escape }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="root-helps-values__grid">
        {%- for block in section.blocks -%}
          <div class="root-helps-values__item" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="root-helps-values__item-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="root-helps-values__item-description">
                {{ block.settings.description }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Root Helps Values",
  "tag": "section",
  "class": "section-root-helps-values",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section subtitle"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "value_item",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Value title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Value description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Helps Values",
      "settings": {
        "subtitle": "WHAT WE VALUE"
      },
      "blocks": [
        {
          "type": "value_item",
          "settings": {
            "title": "Quality",
            "description": "<p>Packed with essential protein to keep your body strong and your brain fit</p>"
          }
        },
        {
          "type": "value_item",
          "settings": {
            "title": "Empathy",
            "description": "<p>Our medically derived formula makes sure you have the right vitamins to help with lactation production</p>"
          }
        },
        {
          "type": "value_item",
          "settings": {
            "title": "Community",
            "description": "<p>Breastfeeding moms need an extra 500 calories a day to help with milk production. We help you get there.</p>"
          }
        },
        {
          "type": "value_item",
          "settings": {
            "title": "Vulnerability",
            "description": "<p>Our proprietary blend provides for an increase in supply</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

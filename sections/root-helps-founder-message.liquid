{% comment %}
  Founder Message Section

  Features the founding story with a background image and right-aligned content.
  Displays the founder's message about commitment to product quality and values.
{% endcomment %}

{{ 'section-root-helps-founder-message.css' | asset_url | stylesheet_tag }}

<section
  class="root-helps-section root-helps-founder-message"
  id="RootHelpsFounderMessage-{{ section.id }}"
  style="
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url }}');
    {% else %}
      background-image: url('{{ 'founder-message-bg-6d7afd.jpg' | asset_url }}');
    {% endif %}
    --section-height: {{ section.settings.section_height }}px;
    --heading-color: {{ section.settings.heading_color }};
    --subtext-color: {{ section.settings.subtext_color }};
    --label-color: {{ section.settings.label_color }};
    --label-bg-color: {{ section.settings.label_bg_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | times: 0.01 }};
  "
>
  {% if section.settings.show_overlay %}
    <div class="root-helps-founder-message__overlay"></div>
  {% endif %}

  <div class="root-helps-section__container">
    <div class="root-helps-founder-message__container">
      <div class="root-helps-founder-message__content">
        {% if section.settings.heading != blank %}
          <h2 class="root-helps-founder-message__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <p class="root-helps-founder-message__subtext">
            {{ section.settings.subtext }}
          </p>
        {% endif %}

        {% if section.settings.label != blank %}
          <a href="{{ section.settings.action_link }}" class="root-helps-founder-message__label-text root-helps-founder-message__label">
            {{ section.settings.label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Helps Founder",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Recommended size: 1440x689px"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main heading",
      "default": "Committed to delivering the most complete product possible"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "We value what we put in our body just as much as you do."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "OUR FOUNDING STORY"
    },
    {
      "type": "url",
      "id": "action_link",
      "label": "Action link",
      "default": "/"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (px)",
      "min": 400,
      "max": 800,
      "step": 50,
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show background overlay",
      "default": false,
      "info": "Adds a dark overlay to improve text readability"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (%)",
      "min": 0,
      "max": 70,
      "step": 5,
      "default": 20,
      "info": "Only applies if overlay is enabled"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#E5653D"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "label_bg_color",
      "label": "Label background color",
      "default": "#E5653D"
    }
  ],
  "presets": [
    {
      "name": "Root Helps Founder Message"
    }
  ]
}
{% endschema %}

{% comment %}
  Ingredient List Section

  Dynamic ingredient list section with categories and ingredient items.
{% endcomment %}

{{ 'section-root-helps-ingredient-list.css' | asset_url | stylesheet_tag }}

<section
  class="root-helps-section root-helps-ingredient-list"
  id="RootHelpsIngredientList-{{ section.id }}"
  style="
    --background-color: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --category-color: {{ section.settings.category_color }};
    --ingredient-color: {{ section.settings.ingredient_color }};
    --accent-color: {{ section.settings.accent_color }};
  "
>
  <div class="root-helps-section__container">
    <div class="root-helps-ingredient-list__grid">
      <!-- Categories and Ingredients List -->
      <div class="root-helps-ingredient-list__categories snap-scroll horizontal">
        {% assign category_blocks = section.blocks
          | where: 'type', 'ingredient_category'
          | sort: 'settings.category_order'
        %}
        {% if category_blocks.size > 0 %}
          {% for block in category_blocks %}
            <div
              class="root-helps-ingredient-list__category"
              {{ block.shopify_attributes }}
            >
              <!-- Category Title -->
              {% if block.settings.category_title != blank %}
                <h3 class="root-helps-ingredient-list__category-title">
                  {{ block.settings.category_title }}
                </h3>
              {% endif %}

              <!-- Ingredients List -->
              <div class="root-helps-ingredient-list__ingredients snap-scroll horizontal">
                {% assign ingredient_blocks = section.blocks
                  | where: 'type', 'ingredient_item'
                  | sort: 'settings.ingredient_order'
                %}
                {% for ingredient_block in ingredient_blocks %}
                  {% assign ingredient_category = ingredient_block.settings.parent_category %}
                  {% if ingredient_category == 'custom' and ingredient_block.settings.custom_parent_category != blank %}
                    {% assign ingredient_category = ingredient_block.settings.custom_parent_category %}
                  {% endif %}

                  {% if ingredient_category == block.settings.category_id
                    and ingredient_block.settings.ingredient_title != blank
                  %}
                    <a
                      class="root-helps-ingredient-list__ingredient-item"
                      data-ingredient-trigger
                      data-ingredient-title="{{ ingredient_block.settings.ingredient_title | escape }}"
                      data-ingredient-subtitle="{{ ingredient_block.settings.ingredient_subtitle | escape }}"
                      data-ingredient-description="{{ ingredient_block.settings.ingredient_description | escape }}"
                      data-ingredient-why-title="{{ ingredient_block.settings.ingredient_why_title | default: 'Why we chose this?' | escape }}"
                      data-ingredient-why-content="{{ ingredient_block.settings.ingredient_why_content | escape }}"
                      data-ingredient-research-title="{{ ingredient_block.settings.ingredient_research_title | default: 'Research and Sources' | escape }}"
                      data-ingredient-research-content="{{ ingredient_block.settings.ingredient_research_content | escape }}"
                      {% if ingredient_block.settings.ingredient_image != blank %}
                        data-ingredient-image="{{ ingredient_block.settings.ingredient_image | image_url: width: 800 }}"
                      {% endif %}
                      {{ ingredient_block.shopify_attributes }}
                    >
                      <!-- Category Dot Indicator -->
                      <span class="root-helps-ingredient-list__category-dot"></span>
                      <span>{{ ingredient_block.settings.ingredient_title }}</span>
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <!-- Featured Ingredient Content -->
      <div class="root-helps-ingredient-list__featured">
        <!-- Featured Ingredient Background Image -->
        <div class="root-helps-ingredient-list__featured-image mobile">
          {% if section.settings.featured_image != blank %}
            <img
              src="{{ section.settings.featured_image | image_url }}"
              alt="{{ section.settings.featured_title | escape }}"
              class="root-helps-ingredient-list__featured-bg"
              loading="lazy"
              width=""
              height=""
            >
          {% else %}
            <img
              src="{{ 'ingredient-detail-bg-2c659c.jpg' | asset_url }}"
              alt="{{ section.settings.featured_title | escape | default: 'Featured ingredient' }}"
              class="root-helps-ingredient-list__featured-bg"
              loading="lazy"
              width=""
              height=""
            >
          {% endif %}
        </div>
        <div class="root-helps-ingredient-list__featured-content" id="featured-content-{{ section.id }}">
          <h3 class="root-helps-ingredient-list__featured-title font-gt-super-display" data-content="title">
            Select an ingredient to learn more
          </h3>

          <p class="root-helps-ingredient-list__featured-subtitle" data-content="subtitle"></p>

          <p class="root-helps-ingredient-list__featured-description" data-content="description">
            Click on any ingredient to see detailed information about its benefits and research.
          </p>

          <div class="root-helps-ingredient-list__featured-section">
            <h4 class="root-helps-ingredient-list__featured-section-title" data-content="why-title">
              Why we chose this?
            </h4>
            <p class="root-helps-ingredient-list__featured-section-content" data-content="why-content"></p>
          </div>

          <div class="root-helps-ingredient-list__featured-section">
            <h4 class="root-helps-ingredient-list__featured-section-title" data-content="research-title">
              Research and Sources
            </h4>
            <p class="root-helps-ingredient-list__featured-section-content" data-content="research-content"></p>
          </div>
        </div>
      </div>
    </div>
    <!-- Featured Ingredient Background Image -->
    <div class="root-helps-ingredient-list__featured-image desktop">
      {% if section.settings.featured_image != blank %}
        <img
          src="{{ section.settings.featured_image | image_url }}"
          alt="{{ section.settings.featured_title | escape }}"
          class="root-helps-ingredient-list__featured-bg"
          loading="lazy"
          width=""
          height=""
        >
      {% else %}
        <img
          src="{{ 'ingredient-detail-bg-2c659c.jpg' | asset_url }}"
          alt="{{ section.settings.featured_title | escape | default: 'Featured ingredient' }}"
          class="root-helps-ingredient-list__featured-bg"
          loading="lazy"
          width=""
          height=""
        >
      {% endif %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const ingredientSection = document.getElementById('RootHelpsIngredientList-{{ section.id }}');
    if (!ingredientSection) return;

    const triggers = ingredientSection.querySelectorAll('[data-ingredient-trigger]');
    const featuredContent = ingredientSection.querySelector('#featured-content-{{ section.id }}');
    const featuredImageMobile = ingredientSection.querySelector('.root-helps-ingredient-list__featured-image.mobile .root-helps-ingredient-list__featured-bg');
    const featuredImageDesktop = ingredientSection.querySelector('.root-helps-ingredient-list__featured-image.desktop .root-helps-ingredient-list__featured-bg');

    if (!featuredContent) return;

    // Store default image URLs for fallback
    const defaultImageUrl = '{{ section.settings.featured_image | image_url | default: 'ingredient-detail-bg-2c659c.jpg' | asset_url }}';
    const defaultAlt = '{{ section.settings.featured_title | escape | default: 'Featured ingredient' }}';

    // Initialize with fade-in class if there's default content
    const hasDefaultContent =
      featuredContent.querySelector('[data-content="title"]').textContent.trim() !==
      'Select an ingredient to learn more';
    if (hasDefaultContent) {
      featuredContent.classList.add('fade-in');
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', function () {
        console.log('Ingredient trigger clicked:', this);
        // Get data attributes
        const ingredient_item = this.getAttribute('data-ingredient-item') || '';
        const title = this.getAttribute('data-ingredient-title') || '';
        const subtitle = this.getAttribute('data-ingredient-subtitle') || '';
        const description = this.getAttribute('data-ingredient-description') || '';
        const whyTitle = this.getAttribute('data-ingredient-why-title') || 'Why we chose this?';
        const whyContent = this.getAttribute('data-ingredient-why-content') || '';
        const researchTitle = this.getAttribute('data-ingredient-research-title') || 'Research and Sources';
        const researchContent = this.getAttribute('data-ingredient-research-content') || '';
        const imageUrl = this.getAttribute('data-ingredient-image') || '';

        // Remove active state from all triggers
        triggers.forEach((t) => t.classList.remove('active'));

        // Add active state to clicked trigger
        this.classList.add('active');

        // Fade out current content
        featuredContent.classList.remove('fade-in');

        setTimeout(() => {
          // Update content
          const titleEl = featuredContent.querySelector('[data-content="title"]');
          const subtitleEl = featuredContent.querySelector('[data-content="subtitle"]');
          const descriptionEl = featuredContent.querySelector('[data-content="description"]');
          const whyTitleEl = featuredContent.querySelector('[data-content="why-title"]');
          const whyContentEl = featuredContent.querySelector('[data-content="why-content"]');
          const researchTitleEl = featuredContent.querySelector('[data-content="research-title"]');
          const researchContentEl = featuredContent.querySelector('[data-content="research-content"]');

          if (titleEl) titleEl.textContent = title;
          if (subtitleEl) subtitleEl.textContent = subtitle;
          if (descriptionEl) descriptionEl.textContent = description;
          if (whyTitleEl) whyTitleEl.textContent = whyTitle;
          if (whyContentEl) whyContentEl.innerHTML = whyContent;
          if (researchTitleEl) researchTitleEl.textContent = researchTitle;
          if (researchContentEl) researchContentEl.innerHTML = researchContent;

          // Update background images with fallback logic
          const finalImageUrl = imageUrl || defaultImageUrl;
          const finalAlt = title || defaultAlt;

          if (featuredImageMobile) {
            featuredImageMobile.src = finalImageUrl;
            featuredImageMobile.alt = finalAlt;
          }

          if (featuredImageDesktop) {
            featuredImageDesktop.src = finalImageUrl;
            featuredImageDesktop.alt = finalAlt;
          }

          // Fade in new content
          featuredContent.classList.add('fade-in');
        }, 200); // Half of transition duration
      });
    });

    // Auto-click first ingredient if available
    if (triggers.length > 0) {
      triggers[0].click();
    }
  });
</script>


{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
  assign background_image = section.settings.background_image
  assign padding_top = section.settings.padding_top | default: 60
  assign padding_bottom = section.settings.padding_bottom | default: 60

  if heading == blank
    assign heading = 'A proprietary formula rooted in science'
  endif

  if description == blank
    assign description = 'After more than 2 years and 17 rounds of formulation, we believe we created the most robust drink possible'
  endif

  if button_text == blank
    assign button_text = 'Learn More'
  endif

  if button_url == blank
    assign button_url = '#'
  endif
-%}

{{ 'section-root-helps-science-backed-formula.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
{% endstyle %}

<section
  class="root-helps-section root-helps-science-backed-formula section-{{ section.id }}-padding"
  id="root-helps-science-formula-{{ section.id }}"
>
  <div class="root-helps-section__container root-helps-science-formula__container">
    <div class="root-helps-science-formula__image-container">
      {% if background_image %}
        <img
          src="{{ background_image | asset_url }}"
          class="root-helps-science-formula__image"
          width=""
          height=""
          loading="lazy"
          alt="{{ heading }}"
          sizes="(min-width: 1200px) 922px, (min-width: 768px) 400px, 400px"
        >
      {% else %}
        <img
          src="{{ 'science-formula-bg.jpg' | asset_url }}"
          class="root-helps-science-formula__image"
          width=""
          height=""
          loading="lazy"
          alt="{{ heading }}"
          sizes="(min-width: 1200px) 922px, (min-width: 768px) 400px, 400px"
        >
      {% endif %}
    </div>

    <div class="root-helps-science-formula__content">
      {% if heading != blank %}
        <h2 class="root-helps-science-formula__heading">{{ heading }}</h2>
      {% endif %}

      {% if description != blank %}
        <p class="root-helps-science-formula__description">{{ description }}</p>
      {% endif %}

      {% if button_text != blank and button_url != blank %}
        <a
          href="{{ button_url }}" class="root-helps-science-formula__button"
          aria-describedby="root-helps-science-formula-{{ section.id }}"
        >
            {{ button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Helps Science",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A proprietary formula rooted in science"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "After more than 2 years and 17 rounds of formulation, we believe we created the most robust drink possible"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "default": "/"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Recommended size: 922x702px for desktop, 400x304px for mobile"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Root Helps Science Backed Formula"
    }
  ]
}
{% endschema %}

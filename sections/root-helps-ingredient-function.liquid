{% comment %}
  Ingredient Function Section

  Dynamic ingredient function section showing ingredients and their health benefits.
  Features two-column layout with content on left and ingredient list on right.
{% endcomment %}

{{ 'section-root-helps-ingredient-function.css' | asset_url | stylesheet_tag }}

<section
  class="root-helps-section root-helps-ingredient-function"
  id="RootHelpsIngredientFunction-{{ section.id }}"
  style="
    --background-color: {{ section.settings.background_color }};
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --ingredient-name-color: {{ section.settings.ingredient_name_color }};
    --ingredient-function-color: {{ section.settings.ingredient_function_color }};
    --divider-color: {{ section.settings.divider_color }};
    --button-border-color: {{ section.settings.button_border_color }};
    --button-text-color: {{ section.settings.button_text_color }};
  "
>
  <div class="root-helps-section__container root-helps-ingredient-function__container">
    <div class="root-helps-ingredient-function__grid">
      <!-- Left Column: Content -->
      <div class="root-helps-ingredient-function__content">
        {% if section.settings.content_image != blank or section.settings.fallback_image != blank %}
          <div class="root-helps-ingredient-function__image-wrapper">
            <img
              class="root-helps-ingredient-function__image"
              src="{% if section.settings.content_image != blank %}{{ section.settings.content_image | image_url }}{% else %}{{ section.settings.fallback_image | asset_url }}{% endif %}"
              alt="{% if section.settings.content_image != blank %}{{ section.settings.content_image.alt | escape }}{% else %}Functional ingredients{% endif %}"
              loading="lazy"
              width=""
              height=""
            >
          </div>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="root-helps-ingredient-function__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p class="root-helps-ingredient-function__subtitle">
            {{ section.settings.subtitle }}
          </p>
        {% endif %}
      </div>

      <!-- Right Column: Ingredient Functions -->
      <div class="root-helps-ingredient-function__ingredients">
        {% if section.blocks.size > 0 %}
          <div class="root-helps-ingredient-function__list">
            {% for block in section.blocks %}
              <div
                class="root-helps-ingredient-function__item"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.ingredient_name != blank %}
                  <h3 class="root-helps-ingredient-function__ingredient-name">
                    {{ block.settings.ingredient_name }}
                  </h3>
                {% endif %}

                {% if block.settings.ingredient_function != blank %}
                  <p class="root-helps-ingredient-function__ingredient-function">
                    {{ block.settings.ingredient_function }}
                  </p>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank and section.settings.button_url != blank %}
          <div class="root-helps-ingredient-function__cta">
            <a
              href="{{ section.settings.button_url }}"
              class="root-helps-ingredient-function__button"
              {% if section.settings.button_url contains 'http' %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Helps Ingred",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"

{{ 'section-root-health-subheader.css' | asset_url | stylesheet_tag }}

<section
  class="root-health-section subheader"
  id="Subheader-{{ section.id }}"
  style="
    --subheader-heading-color: {{ section.settings.heading_color | default: '#E5653D' }};
    --subheader-text-color: {{ section.settings.text_color | default: '#000000' }};
    --subheader-background-shape-color: {{ section.settings.background_shape_color | default: '#FE9A68' }};
    --subheader-padding-top: {{ section.settings.padding_top | default: 15 }}px;
    --subheader-padding-bottom: {{ section.settings.padding_bottom | default: 15 }}px;
  "
>
  <div class="root-health-section__container">
    <div class="subheader__container">
      <div class="subheader__content">
        <div class="subheader__visual-section">
          {% if section.settings.product_image_filename != blank %}
            <div class="subheader__image">
              <img
                src="{{ section.settings.product_image_filename | asset_url }}"
                alt=""
                loading="lazy"
                class="subheader__product-image"
              >
            </div>
          {% elsif section.settings.product_image != blank %}
            <div class="subheader__image">
              {{
                section.settings.product_image
                | image_url: width: 800
                | image_tag: loading: 'lazy', alt: section.settings.product_image.alt, class: 'subheader__product-image'
              }}
            </div>
          {% endif %}
        </div>

        <div class="subheader__text-section">
          {% if section.settings.heading != blank %}
            <h2 class="subheader__heading">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <p class="subheader__description">{{ section.settings.description }}</p>
          {% endif %}

          {% if section.blocks.size > 0 %}
            <div class="subheader__benefits">
              {% if section.settings.benefits_heading != blank %}
                <p class="subheader__benefits-heading type-label">{{ section.settings.benefits_heading }}</p>
              {% endif %}

              <div class="subheader__benefits-list">
                {% for block in section.blocks %}
                  {% case block.type %}
                    {% when 'benefit' %}
                      <div class="subheader__benefit" {{ block.shopify_attributes }}>
                        {% if block.settings.title != blank %}
                          <h4 class="subheader__benefit-title">{{ block.settings.title }}</h4>
                        {% endif %}
                        {% if block.settings.description != blank %}
                          <p class="subheader__benefit-description">{{ block.settings.description }}</p>
                        {% endif %}
                        {% unless forloop.last %}
                          <div class="subheader__benefit-line" aria-hidden="true"></div>
                        {% endunless %}
                      </div>
                  {% endcase %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Health Subheader",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "One bottle for you = less bottles for them",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "default": "Breastfeeding can be the most rewarding experience for new moms, but it does not come without its challenges. Our daily nutrient shake helps you take those challenges head on.",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "benefits_heading",
      "default": "KEY BENEFITS",
      "label": "Benefits heading"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "product_image_filename",
      "label": "Product image (asset filename)",
      "info": "Optional. Filename of an image in your theme assets, e.g. RH-330_Mockup.png. Overrides the image picker above."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "default": "#E5653D",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#000000",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "background_shape_color",
      "default": "#FE9A68",
      "label": "Background shape color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Benefit title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Benefit description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Health Subheader",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Promotes Lactation",
            "description": "97% of women saw an increase or status quo for their milk supply."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Saves Time",
            "description": "93% of women say they saved more than 20 minutes per day by drinking the Shake."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Reduces Stress",
            "description": "87% of Women say they felt less stressed about the day knowing they had a healthy nutrition option."
          }
        }
      ]
    }
  ]
}
{% endschema %}

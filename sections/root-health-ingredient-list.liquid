{% comment %}
  Ingredient List Section

  Card carousel driven by the 'ingredients' metaobject. Category tabs switch
  between horizontally-scrolling rows of ingredient cards; clicking a card
  expands it (accordion) to reveal detail content.
{% endcomment %}

{{ 'section-root-health-ingredient-list.css' | asset_url | stylesheet_tag }}

<section
  class="root-health-section root-health-ingredient-list ril"
  id="RootHelpsIngredientList-{{ section.id }}"
  style="
    --background-color: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --category-color: {{ section.settings.category_color }};
    --ingredient-color: {{ section.settings.ingredient_color }};
    --accent-color: {{ section.settings.accent_color }};
    --ril-tab-active: {{ section.settings.accent_color | default: '#e5653d' }};
    --ril-tab-inactive: {{ section.settings.text_color | default: '#333333' }};
  "
>
  <div class="root-health-section__container ril__container">
    {% if section.settings.section_heading != blank %}
      <h2 class="ril__heading font-gt-super-display">
        {{ section.settings.section_heading }}
      </h2>
    {% endif %}

    {%- comment -%} Pull ingredients directly from the 'ingredients' metaobject {%- endcomment -%}
    {%- assign ingredient_entries = shop.metaobjects.ingredients.values -%}

    {%- comment -%} Build the ordered, de-duplicated list of categories {%- endcomment -%}
    {%- if section.settings.category_order != blank -%}
      {%- assign category_keys = section.settings.category_order | split: ',' -%}
    {%- else -%}
      {%- assign discovered = '' -%}
      {%- for entry in ingredient_entries -%}
        {%- assign ec = entry.category.value | default: 'Other' -%}
        {%- unless discovered contains ec -%}
          {%- assign discovered = discovered | append: ec | append: '~~' -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- assign category_keys = discovered | split: '~~' -%}
    {%- endif -%}

    {%- comment -%} Category tabs {%- endcomment -%}
    <div class="ril__tabs" role="tablist">
      {%- assign tab_index = 0 -%}
      {%- for category_raw in category_keys -%}
        {%- assign category_name = category_raw | strip -%}
        {%- if category_name == blank -%}{%- continue -%}{%- endif -%}
        {%- assign category_handle = category_name | handleize -%}
        <button
          type="button"
          class="ril__tab type-label{% if tab_index == 0 %} is-active{% endif %}"
          role="tab"
          data-ril-tab="{{ category_handle | escape }}"
          aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
        >
          {{ category_name }}
        </button>
        {%- assign tab_index = tab_index | plus: 1 -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Category panels, each a horizontally-scrolling card row {%- endcomment -%}
    <div class="ril__panels">
      {%- assign panel_index = 0 -%}
      {%- for category_raw in category_keys -%}
        {%- assign category_name = category_raw | strip -%}
        {%- if category_name == blank -%}{%- continue -%}{%- endif -%}
        {%- assign category_handle = category_name | handleize -%}
        <div
          class="ril__panel{% if panel_index == 0 %} is-active{% endif %}"
          role="tabpanel"
          data-ril-panel="{{ category_handle | escape }}"
        >
          <div class="ril__row">
            {%- for entry in ingredient_entries -%}
              {%- assign entry_category = entry.category.value | default: 'Other' -%}
              {%- if entry_category == category_name and entry.name.value != blank -%}
                {%- assign ingredient_img = '' -%}
                {%- if entry.image.value != blank -%}
                  {%- assign ingredient_img = entry.image.value | image_url: width: 800 -%}
                {%- endif -%}
                <article
                  class="ril-card"
                  data-ril-card
                  tabindex="0"
                  role="button"
                  aria-expanded="false"
                >
                  {%- if ingredient_img != blank -%}
                    <img
                      class="ril-card__img"
                      src="{{ ingredient_img }}"
                      alt="{{ entry.name.value | escape }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="ril-card__img ril-card__img--placeholder" aria-hidden="true"></span>
                  {%- endif -%}

                  <div class="ril-card__detail">
                    <div class="ril-card__detail-block ril-card__detail-block--why">
                      <h4 class="ril-card__detail-heading">Why we chose this?</h4>
                      <p class="ril-card__detail-text">{{ entry.description.value | escape | newline_to_br }}</p>
                    </div>
                    <div class="ril-card__detail-block ril-card__detail-block--research">
                      <h4 class="ril-card__detail-heading ril-card__detail-heading--sm">Research and Sources</h4>
                      <div class="ril-card__detail-source">{{ entry.source | metafield_tag }}</div>
                    </div>
                  </div>

                  <div class="ril-card__footer">
                    <h3 class="ril-card__name font-gt-super-display">{{ entry.name.value }}</h3>
                    {%- if entry.purpose.value != blank -%}
                      <p class="ril-card__purpose">{{ entry.purpose.value }}</p>
                    {%- endif -%}
                    {%- if entry.value.value != blank -%}
                      <p class="ril-card__value">{{ entry.value.value }}% of recommended daily value</p>
                    {%- endif -%}
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {%- assign panel_index = panel_index | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('RootHelpsIngredientList-{{ section.id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('[data-ril-tab]');
    var panels = section.querySelectorAll('[data-ril-panel]');

    function collapseAllCards() {
      section.querySelectorAll('.ril-card.is-open').forEach(function (card) {
        card.classList.remove('is-open');
        card.setAttribute('aria-expanded', 'false');
      });
    }

    // Tab switching
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var key = tab.getAttribute('data-ril-tab');

        tabs.forEach(function (t) {
          var active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        panels.forEach(function (panel) {
          panel.classList.toggle('is-active', panel.getAttribute('data-ril-panel') === key);
        });

        collapseAllCards();
      });
    });

    // Card accordion (one open at a time per row)
    section.querySelectorAll('[data-ril-card]').forEach(function (card) {
      function toggleCard() {
        var willOpen = !card.classList.contains('is-open');
        var row = card.closest('.ril__row');
        if (row) {
          row.querySelectorAll('.ril-card.is-open').forEach(function (openCard) {
            if (openCard !== card) {
              openCard.classList.remove('is-open');
              openCard.setAttribute('aria-expanded', 'false');
            }
          });
        }
        card.classList.toggle('is-open', willOpen);
        card.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      }

      card.addEventListener('click', toggleCard);
      card.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar') {
          event.preventDefault();
          toggleCard();
        }
      });
    });
  })();
</script>


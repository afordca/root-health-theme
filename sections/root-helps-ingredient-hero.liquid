{% comment %}
  Root Helps - Ingredient Hero Section
  Full-screen hero section with background image and overlay text
{% endcomment %}
{{ 'section-root-helps-ingredient-hero.css' | asset_url | stylesheet_tag }}

<section
  class="section-root-helps-ingredient-hero color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- if section.settings.background_image_desktop or section.settings.background_image_mobile -%}
    <picture class="ingredient-hero__background">
      {%- if section.settings.background_image_mobile -%}
        <source
          media="(max-width: 767px)"
          srcset="{{ section.settings.background_image_mobile | image_url: width: 767 }} 767w,
                  {{ section.settings.background_image_mobile | image_url: width: 1534 }} 1534w"
          sizes="100vw"
        >
      {%- endif -%}

      {%- if section.settings.background_image_desktop -%}
        <img
          src="{{ section.settings.background_image_desktop | image_url: width: 1440 }}"
          srcset="{{ section.settings.background_image_desktop | image_url: width: 1440 }} 1440w,
                  {{ section.settings.background_image_desktop | image_url: width: 2880 }} 2880w"
          sizes="100vw"
          alt="{{ section.settings.background_image_desktop.alt | escape }}"
          loading="lazy"
          width=""
          height=""
        >
      {%- else -%}
        <img
          src="{{ section.settings.background_image_mobile | image_url: width: 1440 }}"
          srcset="{{ section.settings.background_image_mobile | image_url: width: 1440 }} 1440w,
                  {{ section.settings.background_image_mobile | image_url: width: 2880 }} 2880w"
          sizes="100vw"
          alt="{{ section.settings.background_image_mobile.alt | escape }}"
          loading="lazy"
          width=""
          height=""
        >
      {%- endif -%}
    </picture>
  {%- endif -%}

  <div class="ingredient-hero__content">
    {%- if section.settings.title != blank -%}
      <h1 class="ingredient-hero__title">
        {{ section.settings.title | escape }}
      </h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="ingredient-hero__description">
        {{ section.settings.description }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Root Helps Ingred H",
  "tag": "section",
  "class": "section-root-helps-ingredient-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Root Helps Ingredient Hero",
      "settings": {
        "title": "The cleanest ingredients for your little ones",
        "description": "<p>We source the highest quality ingredients from trusted suppliers around the world to create our premium formulas.</p>"
      }
    }
  ]
}
{% endschema %}

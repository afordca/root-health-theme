{% comment %}
  Medical Advisors Section

  Showcases the medical professionals who provide expertise and guidance for the product.
  Features a responsive grid layout with advisor photos, names, credentials, and personal details.
{% endcomment %}

{{ 'section-root-helps-medical-advisors.css' | asset_url | stylesheet_tag }}

<section
  class="root-helps-section root-helps-medical-advisors"
  id="RootHelpsMedicalAdvisors-{{ section.id }}"
  style="
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --name-color: {{ section.settings.name_color }};
    --credential-color: {{ section.settings.credential_color }};
    --mother-label-color: {{ section.settings.mother_label_color }};
    --card-bg-color: {{ section.settings.card_bg_color }};
    --border-color: {{ section.settings.border_color }};
  "
>
  <div class="root-helps-section__container" id="medical-expertise">
    <div class="root-helps-medical-advisors__container">
      {% if section.settings.heading != blank %}
        <div class="root-helps-medical-advisors__header">
          <h2 class="root-helps-medical-advisors__heading">
            {{ section.settings.heading }}
          </h2>
          {% if section.settings.description != blank %}
            <p class="root-helps-medical-advisors__description">
              {{ section.settings.description }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="root-helps-medical-advisors__grid">
          {% for block in section.blocks %}
            <div
              class="root-helps-medical-advisors__advisor"
              {{ block.shopify_attributes }}
            >
              <div class="root-helps-medical-advisors__advisor-inner">
                {% if block.settings.advisor_image != blank %}
                  <div class="root-helps-medical-advisors__image-wrapper">
                    <img
                      src="{{ block.settings.advisor_image | image_url: width: 500 }}"
                      alt="{{ block.settings.advisor_name | escape }}"
                      class="root-helps-medical-advisors__image"
                      loading="lazy"
                      width="250"
                      height="250"
                    >
                  </div>
                {% else %}
                  <div class="root-helps-medical-advisors__image-placeholder">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z" fill="currentColor"/>
                      <path d="M12 14C7.58172 14 4 17.5817 4 22H20C20 17.5817 16.4183 14 12 14Z" fill="currentColor"/>
                    </svg>
                  </div>
                {% endif %}

                <div class="root-helps-medical-advisors__content">
                  {% if block.settings.advisor_name != blank %}
                    <h3 class="root-helps-medical-advisors__name">
                      {{ block.settings.advisor_name }}
                    </h3>
                  {% endif %}

                  {% if block.settings.advisor_credential != blank %}
                    <p class="root-helps-medical-advisors__credential">
                      {{ block.settings.advisor_credential }}
                    </p>
                  {% endif %}

                  {% if block.settings.mother_info != blank %}
                    <p class="root-helps-medical-advisors__mother-info">
                      {{ block.settings.mother_info }}
                    </p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Helps Advisors",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Guided by Medical Expertise"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "As we developed our formula and strategy, we sought direct input and feedback from medical professionals. Our advisory board exists as a resource to ensure we are meeting the changing need medical and emotional demands of new mothers."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Advisor name color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "credential_color",
      "label": "Credential color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "mother_label_color",
      "label": "Mother label color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#FE9A68"
    }
  ],
  "blocks": [
    {
      "type": "advisor",
      "name": "Medical Advisor",
      "settings": [
        {
          "type": "image_picker",
          "id": "advisor_image",
          "label": "Advisor photo",
          "info": "Recommended size: 500x500px"
        },
        {
          "type": "text",
          "id": "advisor_name",
          "label": "Advisor name",
          "default": "Dr. Jane Smith, MD"
        },
        {
          "type": "text",
          "id": "advisor_credential",
          "label": "Credentials/Specialty",
          "default": "Board Certified Emergency and Obesity Medicine"
        },
        {
          "type": "text",
          "id": "mother_info",
          "label": "Mother information",
          "default": "Mother of 3",
          "info": "e.g., 'Mother of 3' or similar personal detail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Helps Medical Advisors",
      "blocks": [
        {
          "type": "advisor",
          "settings": {
            "advisor_name": "Katrina Mattingly, MD",
            "advisor_credential": "Board Certified Emergency and Obesity Medicine",
            "mother_info": "Mother of 3"
          }
        },
        {
          "type": "advisor",
          "settings": {
            "advisor_name": "Dr. Sarah Johnson, MD",
            "advisor_credential": "Lactation Consultant",
            "mother_info": "Mother of 3"
          }
        },
        {
          "type": "advisor",
          "settings": {
            "advisor_name": "Dr. Maria Rodriguez, MD",
            "advisor_credential": "OB/GYN",
            "mother_info": "Mother of 3"
          }
        },
        {
          "type": "advisor",
          "settings": {
            "advisor_name": "Dr. Emily Chen, MD",
            "advisor_credential": "Doula",
            "mother_info": "Mother of 3"
          }
        }
      ]
    }
  ]
}
{% endschema %}

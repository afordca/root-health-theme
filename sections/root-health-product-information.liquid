{% comment %}
  Root Health Product Information Section - Clean Version
{% endcomment %}

<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  data-redirect-to-checkout="true"
>
  {{ 'section-root-health-product-information.css' | asset_url | stylesheet_tag }}
  {{ 'section-root-health-product-information-carousel.css' | asset_url | stylesheet_tag }}
  {{ 'product-variant-cards.css' | asset_url | stylesheet_tag }}
  {{ 'dietary-restrictions-grid.css' | asset_url | stylesheet_tag }}
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}

  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    :root {
      --image-background-color: {{ section.settings.image_background_color }};
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <section class="root-health-section root-health-product-information">
    {%- assign product_form_id = 'product-form-' | append: section.id -%}

    <div class="root-health-section__container">
      <!-- Mobile-first layout structure -->
      <div class="root-health-product-information__mobile-layout">
        <!-- 1. Title (Mobile Only) -->
        <div class="root-health-product-information__mobile-title">
          <h1 class="root-health-product-information__title">{{ product.title | escape }}</h1>
        </div>

        <!-- 2. Main Image (Mobile Only) -->
        <div class="root-health-product-information__mobile-image">
          {% if product.featured_media %}
            <img
              id="main-image-mobile-{{ section.id }}"
              src="{{ product.featured_media | image_url: width: 414 }}"
              alt="{{ product.featured_media.alt | escape | default: product.title }}"
              class="root-health-product-information__image"
              loading="lazy"
              width="414"
              height="186"
            >
          {% else %}
            <img
              id="main-image-mobile-{{ section.id }}"
              class="root-health-product-information__image"
              src="{{ 'product-hero-image-642529.jpg' | asset_url }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
              width="414"
              height="186"
            >
          {% endif %}
        </div>

        <!-- 3. Additional Images (Mobile Only) -->
        {% if product.media.size > 0 %}
          <div class="root-health-product-information__mobile-carousel-container snap-scroll horizontal">
            <div class="root-health-product-information__mobile-carousel snap-inner">
              {% for media in product.media limit: 5 %}
                <div class="root-health-product-information__carousel-item" data-media-index="{{ forloop.index0 }}">
                  {% case media.media_type %}
                    {% when 'image' %}
                      <img
                        src="{{ media | image_url: width: 118 }}"
                        alt="{{ media.alt | escape | default: product.title }}"
                        class="root-health-product-information__carousel-image"
                        data-full-src="{{ media | image_url: width: 414 }}"
                        loading="lazy"
                        width="118"
                        height="118"
                      >
                    {% when 'video' %}
                      {{ media | media_tag: class: 'root-health-product-information__carousel-image' }}
                    {% else %}
                      <div class="root-health-product-information__carousel-placeholder"></div>
                  {% endcase %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- 4. Version (Mobile Only) -->
        <div class="root-health-product-information__mobile-version">V 1.0</div>

        <!-- 5-9. Content blocks (Mobile Only) -->
        <div class="root-health-product-information__mobile-content">
          <product-info
            id="ProductInfo-{{ section.id }}"
            data-section="{{ section.id }}"
            data-url="{{ product.url }}"
            data-product-id="{{ product.id }}"
            data-update-url="false"
            data-zoom-on-hover="false"
            data-redirect-to-checkout="true"
            class="product__info-wrapper"
          >
            <product-form
              class="product-form"
              data-hide-errors="false"
              data-section-id="{{ section.id }}"
            >
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                <span class="product-form__error-message"></span>
              </div>

              {%- form 'product',
                product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ product.selected_or_first_available_variant.id }}"
                  {% if product.selected_or_first_available_variant.available == false
                    or product.selected_or_first_available_variant == null
                  %}
                    disabled
                  {% endif %}
                  class="product-variant-id"
                >

                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {%- when 'description' -%}
                      <div class="root-health-product-information__mobile-description" {{ block.shopify_attributes }}>
                        {{ product.description }}
                      </div>

                    {%- when 'custom_benefits' -%}
                      <div class="root-health-product-information__mobile-benefits" {{ block.shopify_attributes }}>
                        {%- for benefits_block in section.blocks -%}
                          {%- if benefits_block.type == 'benefit_item' -%}
                            <div class="root-health-product-information__benefit">
                              {{ benefits_block.settings.benefit_text }}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>

                    {%- when 'variant_picker' -%}
                      <!-- Variant Picker -->
                      <div class="root-health-product-information__mobile-variants" {{ block.shopify_attributes }}>
                        {% render 'product-variant-cards',
                          product: product,
                          section_id: section.id,
                          form_id: product_form_id
                        %}
                      </div>

                    {%- when 'benefit_item' -%}
                      {%- comment -%} Individual benefit items are handled by the custom_benefits container {%- endcomment -%}

                    {%- when 'buy_buttons' -%}
                      <div class="root-health-product-information__mobile-payment" {{ block.shopify_attributes }}>
                        <button
                          id="{{ product_form_id }}-submit"
                          type="submit"
                          name="add"
                          aria-haspopup="dialog"
                          aria-labelledby="{{ product_form_id }}-submit title-{{ section.id }}-{{ product.id }}"
                          aria-live="polite"
                          data-sold-out-message="true"
                          {% if product.selected_or_first_available_variant.available == false %}
                            disabled
                          {% endif %}
                          class="root-health-product-information__payment-button"
                        >
                          <span>
                            {%- if product.selected_or_first_available_variant == null -%}
                              {{ 'products.product.unavailable' | t }}
                            {%- elsif product.selected_or_first_available_variant.available == false -%}
                              {{ 'products.product.sold_out' | t }}
                            {%- else -%}
                              CONTINUE TO PAYMENT
                            {%- endif -%}
                          </span>
                          {%- render 'loading-spinner' -%}
                        </button>
                      </div>
                  {%- endcase -%}
                {%- endfor -%}
              {%- endform -%}
            </product-form>
          </product-info>
        </div>

        <!-- 10. Dietary Restrictions (Mobile Only) -->
        <div class="root-health-product-information__mobile-dietary">
          {% render 'dietary-restrictions-grid' %}
        </div>
      </div>

      <!-- Desktop layout (hidden on mobile) -->
      <div class="root-health-product-information__grid">
        {%- assign product_form_id = 'product-form-' | append: section.id -%}

        <!-- LEFT: thumbnail rail (click to swap main image) -->
        {%- capture rhpi_gallery_raw -%}{{ section.settings.center_image_filename }}|{{ section.settings.rail_image_1_filename }}|{{ section.settings.rail_image_2_filename }}|{{ section.settings.rail_image_3_filename }}|{{ section.settings.rail_image_4_filename }}|{{ section.settings.rail_image_5_filename }}{%- endcapture -%}
        {%- assign rhpi_gallery = rhpi_gallery_raw | split: '|' -%}
        <div class="rhpi-rail">
          {%- for fn in rhpi_gallery -%}
            {%- assign fn = fn | strip -%}
            {%- if fn == blank -%}{%- continue -%}{%- endif -%}
            <button
              type="button"
              class="rhpi-rail__item{% if forloop.first %} is-active{% endif %}"
              data-full-src="{{ fn | asset_url }}"
              aria-label="View product image"
            >
              <img class="rhpi-rail__img" src="{{ fn | asset_url }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>

        <!-- CENTER: product image on orange background -->
        <div class="rhpi-center">
          <div class="rhpi-center__bg">
            {% if section.settings.center_image_filename != blank %}
              <img
                id="main-image-desktop-{{ section.id }}"
                src="{{ section.settings.center_image_filename | asset_url }}"
                alt="{{ product.title | escape }}"
                class="root-health-product-information__image rhpi-center__img"
                loading="lazy"
              >
            {% elsif product.featured_media %}
              <img
                id="main-image-desktop-{{ section.id }}"
                src="{{ product.featured_media | image_url: width: 670 }}"
                alt="{{ product.featured_media.alt | escape | default: product.title }}"
                class="root-health-product-information__image rhpi-center__img"
                loading="lazy"
              >
            {% else %}
              <img
                id="main-image-desktop-{{ section.id }}"
                class="root-health-product-information__image rhpi-center__img"
                src="{{ 'product-hero-image-642529.jpg' | asset_url }}"
                alt="{{ product.title | escape }}"
                loading="lazy"
              >
            {% endif %}
          </div>
        </div>

        <!-- RIGHT: product info + add-to-cart -->
        <div class="rhpi-info">
          <product-form
            class="product-form"
            data-hide-errors="false"
            data-section-id="{{ section.id }}"
          >
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              <span class="product-form__error-message"></span>
            </div>

            {%- form 'product',
              product,
              id: product_form_id,
              class: 'product-form rhpi-form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            -%}
              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
                {% if product.selected_or_first_available_variant.available == false
                  or product.selected_or_first_available_variant == null
                %}
                  disabled
                {% endif %}
                class="product-variant-id"
              >

              <p class="rhpi-info__eyebrow">DIETARY SUPPLEMENT</p>
              <h1 class="rhpi-info__title root-health-product-information__title">{{ product.title | escape }}</h1>

              {%- if product.description != blank -%}
                <div class="rhpi-info__description rte">{{ product.description }}</div>
              {%- endif -%}

              <p class="rhpi-info__benefits-label type-label">Key Benefits</p>
              <div class="rhpi-info__benefits">
                {%- for b in section.blocks -%}
                  {%- if b.type == 'benefit_item' -%}
                    <div class="rhpi-benefit" {{ b.shopify_attributes }}>
                      <span class="rhpi-benefit__icon" aria-hidden="true"></span>
                      <span class="rhpi-benefit__text">{{ b.settings.benefit_text }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <!-- Quantity picker: one row per variant, keeps name="id" wiring -->
              <div class="rhpi-picker">
                {%- assign pb_lines = section.settings.picker_benefits | strip | newline_to_br | split: '<br />' -%}
                {%- for variant in product.variants -%}
                  {%- assign v_months = variant.title | split: ' ' | first | plus: 0 -%}
                  {%- if variant.title contains 'Trial' -%}
                    {%- assign v_tier = 'TRIAL' -%}
                  {%- else -%}
                    {%- assign v_tier = v_months | append: ' MONTH' -%}
                  {%- endif -%}
                  {%- assign v_price = variant.price | money_without_trailing_zeros -%}
                  <div class="rhpi-picker__row{% unless forloop.last %} rhpi-picker__row--divided{% endunless %}{% unless variant.available %} rhpi-picker__row--disabled{% endunless %}">
                    <input
                      type="radio"
                      id="rhpi-Variant-{{ section.id }}-{{ variant.id }}"
                      name="id"
                      value="{{ variant.id }}"
                      class="rhpi-picker__radio"
                      form="{{ product_form_id }}"
                      data-tier="{{ v_tier }}"
                      data-price="{{ v_price }}"
                      {% if variant.id == product.selected_or_first_available_variant.id %}checked{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                    <label for="rhpi-Variant-{{ section.id }}-{{ variant.id }}" class="rhpi-picker__label">
                      <span class="rhpi-picker__dot" aria-hidden="true"></span>
                      <span class="rhpi-picker__name">{{ variant.title | upcase }}</span>
                      <span class="rhpi-picker__pricing">
                        {%- if v_months > 0 -%}
                          <span class="rhpi-picker__permonth">{{ variant.price | divided_by: v_months | money_without_trailing_zeros }} / Mo</span>
                          <span class="rhpi-picker__total">{{ v_price }} Total</span>
                        {%- else -%}
                          <span class="rhpi-picker__permonth">{{ v_price }}</span>
                        {%- endif -%}
                      </span>
                      <span class="rhpi-picker__benefits">
                        {%- for line in pb_lines -%}
                          {%- assign pb = line | strip -%}
                          {%- if pb != blank -%}
                            <span class="rhpi-picker__benefit">{{ pb }}</span>
                          {%- endif -%}
                        {%- endfor -%}
                      </span>
                    </label>
                  </div>
                {%- endfor -%}
              </div>

              <!-- Add to cart: dynamic label via JS, server-rendered default -->
              {%- assign sel = product.selected_or_first_available_variant -%}
              {%- assign sel_months = sel.title | split: ' ' | first | plus: 0 -%}
              {%- if sel.title contains 'Trial' -%}
                {%- assign sel_tier = 'TRIAL' -%}
              {%- else -%}
                {%- assign sel_tier = sel_months | append: ' MONTH' -%}
              {%- endif -%}
              <div class="rhpi-info__cta">
                <button
                  id="ProductSubmitButton-{{ section.id }}"
                  type="submit"
                  name="add"
                  class="product-form__submit rhpi-addtocart"
                  {% if sel.available == false or sel == null %}disabled{% endif %}
                >
                  <span class="rhpi-addtocart__label">
                    {%- if sel == null -%}
                      {{ 'products.product.unavailable' | t }}
                    {%- elsif sel.available == false -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- else -%}
                      {{ sel_tier }} &ndash; {{ sel.price | money_without_trailing_zeros }} &ndash; Add to cart
                    {%- endif -%}
                  </span>
                  {%- render 'loading-spinner' -%}
                </button>
              </div>
            {%- endform -%}

            <!-- Klarna / installment (separate form, not nested) -->
            <div class="rhpi-info__installment">
              {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
              {%- form 'product',
                product,
                id: product_form_installment_id,
                class: 'installment caption-large'
              -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {{ form | payment_terms }}
              {%- endform -%}
            </div>

            <!-- Gift box -->
            {%- assign gift_link = section.settings.gift_url | default: '/products/gift-card' -%}
            <div class="rhpi-gift">
              <div class="rhpi-gift__icon" aria-hidden="true">{% render 'icon-accordion', icon: 'leaf' %}</div>
              <div class="rhpi-gift__body">
                <h3 class="rhpi-gift__heading">{{ section.settings.gift_heading }}</h3>
                <p class="rhpi-gift__text">{{ section.settings.gift_subtext }}</p>
              </div>
              <a href="{{ gift_link }}" class="rhpi-gift__button">Give A Gift</a>
            </div>

            <!-- Dietary icons -->
            <div class="rhpi-info__dietary">
              {% render 'dietary-restrictions-grid', grid_columns: 6 %}
            </div>

            <!-- Bottom accordions -->
            <div class="rhpi-accordions">
              <details class="rhpi-accordion">
                <summary class="rhpi-accordion__summary">
                  <span class="rhpi-accordion__title type-label">INGREDIENTS</span>
                  <span class="rhpi-accordion__marker" aria-hidden="true"></span>
                </summary>
                <div class="rhpi-accordion__content rte">{{ section.settings.ingredients_content }}</div>
              </details>
              <details class="rhpi-accordion">
                <summary class="rhpi-accordion__summary">
                  <span class="rhpi-accordion__title type-label">RECOMMENDATIONS</span>
                  <span class="rhpi-accordion__marker" aria-hidden="true"></span>
                </summary>
                <div class="rhpi-accordion__content rte">{{ section.settings.recommendations_content }}</div>
              </details>
            </div>
          </product-form>
        </div>
      </div>
    </div>
  </section>
</product-info>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Initialize product image carousel functionality
    const sectionId = '{{ section.id }}';

    // Get main images for both mobile and desktop
    const mainImageMobile = document.getElementById(`main-image-mobile-${sectionId}`);
    const mainImageDesktop = document.getElementById(`main-image-desktop-${sectionId}`);

    // Get all carousel items for both mobile and desktop
    const mobileCarouselItems = document.querySelectorAll(
      '.root-health-product-information__mobile-carousel .root-health-product-information__carousel-item'
    );
    const desktopCarouselItems = document.querySelectorAll(
      '.root-health-product-information__grid .root-health-product-information__carousel-item'
    );

    // Function to handle carousel item clicks
    function handleCarouselClick(carouselItems, mainImage, isMobile = false) {
      if (!carouselItems.length || !mainImage) return;

      carouselItems.forEach((item, index) => {
        const img = item.querySelector('.root-health-product-information__carousel-image');

        if (img && img.tagName === 'IMG') {
          // Make carousel item clickable
          item.style.cursor = 'pointer';
          item.setAttribute('role', 'button');
          item.setAttribute('tabindex', '0');
          item.setAttribute('aria-label', `View ${img.alt || 'product image'}`);

          // Add click event listener
          const clickHandler = function () {
            const fullSrc = img.getAttribute('data-full-src');
            const alt = img.getAttribute('alt');

            if (fullSrc && mainImage) {
              // Add loading state
              mainImage.style.opacity = '0.5';

              // Create new image to preload
              const newImg = new Image();
              newImg.onload = function () {
                mainImage.src = fullSrc;
                if (alt) {
                  mainImage.alt = alt;
                }
                mainImage.style.opacity = '1';

                // Update active state on carousel items
                carouselItems.forEach((carouselItem) => {
                  carouselItem.classList.remove('active');
                  carouselItem.setAttribute('aria-selected', 'false');
                });
                item.classList.add('active');
                item.setAttribute('aria-selected', 'true');
              };
              newImg.src = fullSrc;
            }
          };

          item.addEventListener('click', clickHandler);

          // Add keyboard support
          item.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              clickHandler();
            }
          });

          // Set first item as active by default
          if (index === 0) {
            item.classList.add('active');
            item.setAttribute('aria-selected', 'true');
          } else {
            item.setAttribute('aria-selected', 'false');
          }
        }
      });
    }

    // Initialize mobile carousel
    if (mobileCarouselItems.length > 0 && mainImageMobile) {
      handleCarouselClick(mobileCarouselItems, mainImageMobile, true);
    }

    // Initialize desktop carousel
    if (desktopCarouselItems.length > 0 && mainImageDesktop) {
      handleCarouselClick(desktopCarouselItems, mainImageDesktop, false);
    }
  });
</script>

<script>
  // Dynamic Add-to-Cart label for the desktop quantity picker.
  (function () {
    var sectionId = '{{ section.id }}';
    var root = document.getElementById('MainProduct-' + sectionId) || document;
    var btn = document.getElementById('ProductSubmitButton-' + sectionId);
    if (!btn) return;
    var label = btn.querySelector('.rhpi-addtocart__label');
    var radios = root.querySelectorAll('.rhpi-picker__radio');
    if (!label || !radios.length) return;

    function updateLabel(radio) {
      if (!radio || radio.disabled) return;
      var tier = radio.getAttribute('data-tier') || '';
      var price = radio.getAttribute('data-price') || '';
      label.textContent = tier + ' – ' + price + ' – Add to cart';
    }

    radios.forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (radio.checked) updateLabel(radio);
      });
      if (radio.checked) updateLabel(radio);
    });
  })();
</script>

<script>
  (function () {
    var scope = document.getElementById('shopify-section-{{ section.id }}');
    if (!scope) return;
    var thumbs = Array.prototype.slice.call(scope.querySelectorAll('.rhpi-rail__item'));
    var mainImg = document.getElementById('main-image-desktop-{{ section.id }}');
    if (!thumbs.length || !mainImg) return;
    var srcs = thumbs.map(function (b) { return b.getAttribute('data-full-src'); });
    var idx = 0;

    function show(i) {
      i = (i + srcs.length) % srcs.length;
      idx = i;
      if (srcs[i]) mainImg.src = srcs[i];
      thumbs.forEach(function (b, j) { b.classList.toggle('is-active', j === i); });
    }

    thumbs.forEach(function (b, i) {
      b.addEventListener('click', function () { show(i); });
    });

    /* Swipe on the main image to cycle */
    var startX = null;
    var frame = mainImg.closest('.rhpi-center') || mainImg;
    frame.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    frame.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) { show(dx < 0 ? idx + 1 : idx - 1); }
      startX = null;
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Root Health Product",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "image_background_color",
      "label": "Image background color",
      "default": "#FE9A68"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",

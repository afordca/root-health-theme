{{ 'section-root-health-two-column-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign image = section.settings.image
  assign image_filename = section.settings.image_filename
  assign founding_story_label = section.settings.founding_story_label | default: 'Founding Story'
  assign founding_story = section.settings.founding_story
  assign team_label = section.settings.team_label | default: 'Founding Team'
-%}

<section
  class="section-root-health-two-column-text root-health-section"
  id="section-{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container root-health-section__container">
    <div class="two-col-top">
      <div class="two-col-top__text">
        {%- if heading != blank -%}
          <h2 class="main-heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if description != blank -%}
          <div class="body-text">{{ description | newline_to_br }}</div>
        {%- endif -%}
      </div>
      <div class="two-col-top__media">
        <div
          class="two-col-media"
          {% if image_filename != blank %}
            style="background-image: url('{{ image_filename | asset_url }}');"
          {% elsif image != blank %}
            style="background-image: url('{{ image | image_url: width: 1000 }}');"
          {% endif %}
        ></div>
      </div>
    </div>

    <div class="two-col-accordions">
      {%- if founding_story_label != blank and founding_story != blank -%}
        <details class="accordion" open>
          <summary class="accordion__summary">
            <span class="accordion__label">{{ founding_story_label }}</span>
          </summary>
          <div class="accordion__content accordion__content--rich">{{ founding_story }}</div>
        </details>
      {%- endif -%}

      {%- if team_label != blank -%}
        <details class="accordion" open>
          <summary class="accordion__summary">
            <span class="accordion__label">{{ team_label }}</span>
          </summary>
          <div class="accordion__content">
            <div class="team-grid">
              {%- for block in section.blocks -%}
                {%- if block.type == 'team_member' -%}
                  {%- assign member_image = block.settings.image -%}
                  {%- assign member_image_filename = block.settings.image_filename -%}
                  <div class="team-card" {{ block.shopify_attributes }}>
                    <div
                      class="team-card__photo"
                      {% if member_image_filename != blank %}
                        style="background-image: url('{{ member_image_filename | asset_url }}');"
                      {% elsif member_image != blank %}
                        style="background-image: url('{{ member_image | image_url: width: 400 }}');"
                      {% endif %}
                    ></div>
                    <div class="team-card__info">
                      {%- if block.settings.name != blank -%}
                        <span class="team-card__name">{{ block.settings.name }}</span>
                      {%- endif -%}
                      {%- if block.settings.role != blank -%}
                        <span class="team-card__role">{{ block.settings.role }}</span>
                      {%- endif -%}
                      {%- if block.settings.bio != blank -%}
                        <span class="team-card__bio">{{ block.settings.bio }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </details>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Health Two Col",
  "tag": "section",
  "class": "section-root-health-two-column-text",
  "settings": [
    {
      "type": "header",
      "content": "Top Row"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right column image"
    },
    {
      "type": "text",
      "id": "image_filename",
      "label": "Right column image (asset filename)",
      "info": "Optional. Filename of an image in your theme assets, e.g. two-column-why.jpg. Overrides the image picker above. Leave blank to show a rounded placeholder."
    },
    {
      "type": "header",
      "content": "Founding Story"
    },
    {
      "type": "text",
      "id": "founding_story_label",
      "label": "Founding Story label",
      "default": "Founding Story"
    },
    {
      "type": "richtext",
      "id": "founding_story",
      "label": "Founding Story content"
    },
    {
      "type": "header",
      "content": "Founding Team"
    },
    {
      "type": "text",
      "id": "team_label",
      "label": "Founding Team label",
      "default": "Founding Team"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "image_filename",
          "label": "Photo (asset filename)",
          "info": "Optional. Filename of an image in your theme assets. Overrides the image picker above."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Health Two Column Text",
      "settings": {
        "heading": "We created Root because moms deserve more",
        "description": "As fellow parents, we understand the challenges and struggles that come with parenthood. By sharing our experiences and creating Root, we hope to help new moms save time, energy, and alleviate some of the stressors that we encountered.",
        "founding_story_label": "Founding Story",
        "team_label": "Founding Team"
      },
      "blocks": [
        {
          "type": "team_member"
        },
        {
          "type": "team_member"
        }
      ]
    }
  ]
}
{% endschema %}

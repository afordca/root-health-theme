{{ 'section-root-helps-ingredient-thesis.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign title = section.settings.title
  assign description = section.settings.description
  assign enable_section = section.settings.enable_section
-%}

{%- if enable_section -%}
  <section class="root-helps-section root-health-ingredient-thesis">
    <div class="root-helps-section__container">
      <div class="root-health-ingredient-thesis__content">
        <div class="root-health-ingredient-thesis__text">
          {% if title != blank %}
            <h2 class="root-health-ingredient-thesis__title">{{ title }}</h2>
          {% endif %}
          {% if description != blank %}
            <div class="root-health-ingredient-thesis__description">
              {{ description }}
            </div>
          {% endif %}
        </div>

        <div class="root-health-ingredient-thesis__components">
          {% for block in section.blocks %}
            {%- case block.type -%}
              {%- when 'component' -%}
                <div class="root-health-ingredient-thesis__component" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank %}
                    <div class="root-health-ingredient-thesis__icon">
                      <img src="{{ block.settings.icon | asset_url }}" alt="{{ block.settings.name }}">
                    </div>
                  {% endif %}
                  {% if block.settings.name != blank %}
                    <span class="root-health-ingredient-thesis__component-name">
                      {{ block.settings.name }}
                    </span>
                  {% endif %}
                </div>
            {%- endcase -%}
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Root Helps Ingr Thesis",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "THESIS"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We've identified 5 nutritional components that have a direct impact on your milk supply. We set out to create a product that addressed each of these components without compromising on clean, healthful ingredients that could accommodate various dietary needs and desires.</p>"
    }
  ],
  "blocks": [
    {
      "type": "component",
      "name": "Nutritional Component",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Component name"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon filename",
          "info": "Enter the filename of the SVG icon (e.g., 'icon-hydration.svg')"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Helps Ingredient Thesis",
      "blocks": [
        {
          "type": "component",
          "settings": {
            "name": "Hydration",
            "icon": "icon-hydration.svg"
          }
        },
        {
          "type": "component",
          "settings": {
            "name": "Calories",
            "icon": "icon-calories.svg"
          }
        },
        {
          "type": "component",
          "settings": {
            "name": "Vitamins",
            "icon": "icon-vitamins.svg"
          }
        },
        {
          "type": "component",
          "settings": {
            "name": "Protein",
            "icon": "icon-protein.svg"
          }
        },
        {
          "type": "component",
          "settings": {
            "name": "Galactagogues",
            "icon": "icon-galactagogues.svg"
          }
        }
      ]
    }
  ]
}
{% endschema %}

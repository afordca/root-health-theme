{% comment %}
  Trusted By Section

  Displays partner and brand logos in a horizontal layout to build trust and credibility.
  Features responsive logo grid with customizable partner images and placeholder styling.
{% endcomment %}

{{ 'section-root-helps-trusted-by.css' | asset_url | stylesheet_tag }}

<section
  class="root-helps-section root-helps-trusted-by"
  id="RootHelpsTrustedBy-{{ section.id }}"
  style="
    --heading-color: {{ section.settings.heading_color }};
    --background-color: {{ section.settings.background_color }};
    --placeholder-color: {{ section.settings.placeholder_color }};
    --logo-hover-opacity: {{ section.settings.logo_hover_opacity | times: 0.01 }};
  "
>
  <div class="root-helps-section__container">
    <div class="root-helps-trusted-by__container">
      {% if section.settings.heading != blank %}
        <div class="root-helps-trusted-by__header">
          <h2 class="root-helps-trusted-by__heading">
            {{ section.settings.heading }}
          </h2>
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="root-helps-trusted-by__logos-container snap-scroll horizontal">
          <div class="root-helps-trusted-by__logos snap-scroll-inner">
            {% for block in section.blocks %}
              <div
                id="trusted-by-{{ block.id }}"
                class="root-helps-trusted-by__logo-item snap-scroll-item"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.partner_logo != blank %}
                  <img
                    src="{{ block.settings.partner_logo | image_url: width: 296 }}"
                    alt="{{ block.settings.partner_name | default: 'Partner logo' | escape }}"
                    class="root-helps-trusted-by__logo-image"
                    loading="lazy"
                    width="148"
                    height="48"
                  >
                {% else %}
                  <div class="root-helps-trusted-by__logo-placeholder">
                    {% if block.settings.partner_name != blank %}
                      <span class="root-helps-trusted-by__placeholder-text">
                        {{ block.settings.partner_name }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
            {% for block in section.blocks %}
              <div
                id="trusted-by-{{ block.id }}"
                class="root-helps-trusted-by__logo-item snap-scroll-item"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.partner_logo != blank %}
                  <img
                    src="{{ block.settings.partner_logo | image_url: width: 296 }}"
                    alt="{{ block.settings.partner_name | default: 'Partner logo' | escape }}"
                    class="root-helps-trusted-by__logo-image"
                    loading="lazy"
                    width="148"
                    height="48"
                  >
                {% else %}
                  <div class="root-helps-trusted-by__logo-placeholder">
                    {% if block.settings.partner_name != blank %}
                      <span class="root-helps-trusted-by__placeholder-text">
                        {{ block.settings.partner_name }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
          {% comment %}
            <div class="root-helps-trusted-by__dots snap-scroll-dots">
              {% for block in section.blocks %}
              <a
                href="#trusted-by-{{ block.id }}"
                class="snap-scroll-dot root-helps-trusted-by__link"
              >
                <span class="visually-hidden">Go to {{ block.settings.partner_name | default: 'partner logo' }}</span>
              </a>
              {% endfor %}
            </div>
          {% endcomment %}
        </div>
      {% else %}
        <!-- Default placeholder logos when no blocks are added -->
        <div class="root-helps-trusted-by__logos snap-scroll-inner">
          {% for i in (1..7) %}
            <div class="root-helps-trusted-by__logo-item snap-scroll-item">
              <div class="root-helps-trusted-by__logo-placeholder"></div>
            </div>
          {% endfor %}
          {% for i in (1..7) %}
            <div class="root-helps-trusted-by__logo-item snap-scroll-item">
              <div class="root-helps-trusted-by__logo-placeholder"></div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Helps Trusted",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Trusted By"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "range",
      "id": "logo_hover_opacity",
      "label": "Logo hover opacity (%)",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 80,
      "info": "Logo opacity on hover (as percentage)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FE9A68"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder color",
      "default": "#D9D9D9"
    }
  ],
  "blocks": [
    {
      "type": "partner_logo",
      "name": "Partner Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "partner_logo",
          "label": "Partner logo",
          "info": "Recommended size: 296x96px (2x for retina)"
        },
        {
          "type": "text",
          "id": "partner_name",
          "label": "Partner name",
          "info": "Used for alt text and placeholder display"
        },
        {
          "type": "url",
          "id": "partner_url",
          "label": "Partner website URL",
          "info": "Optional link to partner website"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Helps Trusted By",
      "blocks": [
        {
          "type": "partner_logo",
          "settings": {
            "partner_name": "Partner 1"
          }
        },
        {
          "type": "partner_logo",
          "settings": {
            "partner_name": "Partner 2"
          }
        },
        {
          "type": "partner_logo",
          "settings": {
            "partner_name": "Partner 3"
          }
        },
        {
          "type": "partner_logo",
          "settings": {
            "partner_name": "Partner 4"
          }
        },
        {
          "type": "partner_logo",
          "settings": {
            "partner_name": "Partner 5"
          }
        }
      ]
    }
  ]
}
{% endschema %}

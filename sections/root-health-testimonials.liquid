{% comment %}
  Customer Testimonials Section

  A gallery of vertical video testimonial cards. Each card shows a poster image
  (or a placeholder) with a play-button overlay and links to the testimonial
  video when a URL is provided.
{% endcomment %}

{{ 'section-root-health-testimonials.css' | asset_url | stylesheet_tag }}

<section
  class="root-health-section root-health-testimonials"
  id="RootHelpsTestimonials-{{ section.id }}"
  style="
    --heading-color: {{ section.settings.heading_color }};
    --background-color: {{ section.settings.background_color }};
    --placeholder-color: {{ section.settings.placeholder_color }};
    --play-color: {{ section.settings.play_color }};
  "
>
  <div class="root-health-section__container">
    <div class="root-health-testimonials__container">
      {% if section.settings.heading != blank %}
        <div class="root-health-testimonials__header">
          <p class="root-health-testimonials__heading type-label">
            {{ section.settings.heading }}
          </p>
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="root-health-testimonials__grid">
          {% for block in section.blocks %}
            {% if block.type == 'testimonial' %}
              {% liquid
                assign has_video = false
                if block.settings.video_url != blank
                  assign has_video = true
                endif
              %}
              <{% if has_video %}a href="{{ block.settings.video_url }}" target="_blank" rel="noopener noreferrer"{% else %}div{% endif %}
                class="root-health-testimonials__card{% unless block.settings.image != blank or block.settings.image_filename != blank %} root-health-testimonials__card--placeholder{% endunless %}"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.image_filename != blank %}
                  <img
                    class="root-health-testimonials__media"
                    src="{{ block.settings.image_filename | asset_url }}"
                    alt="{{ block.settings.caption | escape }}"
                    loading="lazy"
                  >
                {% elsif block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 480
                    | image_tag: loading: 'lazy', alt: block.settings.caption, class: 'root-health-testimonials__media'
                  }}
                {% endif %}

                <span class="root-health-testimonials__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
                    <path d="M8 5v14l11-7z" fill="currentColor"></path>
                  </svg>
                </span>

                {% if block.settings.caption != blank %}
                  <span class="root-health-testimonials__caption">{{ block.settings.caption }}</span>
                {% endif %}
              </{% if has_video %}a{% else %}div{% endif %}>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Health Testimonial",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "HOW OTHERS ARE THRIVING ON ROOT"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#E5653D"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder color",
      "default": "#EEEEEE"
    },
    {
      "type": "color",
      "id": "play_color",
      "label": "Play icon color",
      "default": "#FC4C44"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Video Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Poster image",
          "info": "Recommended size: 240x400px"
        },
        {
          "type": "text",
          "id": "image_filename",
          "label": "Poster image (asset filename)",
          "info": "Optional. Overrides the image picker above."
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Optional. Link opened when the card is clicked."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Health Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}

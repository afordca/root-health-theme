          "settings": {
            "quote": "This Subscription has won me Husband of the year award. I stash the shakes bedside, and at 2am, my wife just grabs a shake and she is good until the morning.",
            "customer_name": "Ken",
            "customer_role": "DAD OF 3"
          }

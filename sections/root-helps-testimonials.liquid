          "id": "customer_role",
          "label": "Customer role",
          "default": "MOM OF 2",
          "info": "e.g., 'MOM OF 2', 'DAD OF 3', etc."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Helps Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "I really wish I had this for my first kid. I can't believe how big of a difference this nursing period has been with baby #2. Root has helped me tremendously.",

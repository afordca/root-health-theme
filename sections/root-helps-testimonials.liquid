{% comment %}
  Customer Testimonials Section

  Displays customer testimonials in a responsive grid layout with pagination indicators.
  Features testimonial cards with quotes, customer names, and family details.
{% endcomment %}

{{ 'section-root-helps-testimonials.css' | asset_url | stylesheet_tag }}

<section
  class="root-helps-section root-helps-testimonials"
  id="RootHelpsTestimonials-{{ section.id }}"
  style="
    --heading-color: {{ section.settings.heading_color }};
    --card-bg-color: {{ section.settings.card_bg_color }};
    --card-border-color: {{ section.settings.card_border_color }};
    --quote-color: {{ section.settings.quote_color }};
    --name-color: {{ section.settings.name_color }};
    --role-color: {{ section.settings.role_color }};
    --background-color: {{ section.settings.background_color }};
    --dot-color: {{ section.settings.dot_color }};
    --dot-active-color: {{ section.settings.dot_active_color }};
  "
>
  <div class="root-helps-section__container">
    <div class="root-helps-testimonials__container">
      {% if section.settings.heading != blank %}
        <div class="root-helps-testimonials__header">
          <h2 class="root-helps-testimonials__heading">
            {{ section.settings.heading }}
          </h2>
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="root-helps-testimonials__scroll-container">
          <div class="root-helps-testimonials__grid snap-scroll horizontal no-animation">
            {% for block in section.blocks %}
              <div
                id="testimonial-{{ block.id }}-{{ forloop.index0 }}"
                class="root-helps-testimonials__testimonial snap-scroll-item"
                {{ block.shopify_attributes }}
              >
                <div class="root-helps-testimonials__card">
                  {% if block.settings.quote != blank %}
                    <blockquote class="root-helps-testimonials__quote">
                      {{ block.settings.quote }}
                    </blockquote>
                  {% endif %}

                  <div class="root-helps-testimonials__customer">
                    {% if block.settings.customer_name != blank %}
                      <h3 class="root-helps-testimonials__name">
                        {{ block.settings.customer_name }}
                      </h3>
                    {% endif %}

                    {% if block.settings.customer_role != blank %}
                      <p class="root-helps-testimonials__role">
                        {{ block.settings.customer_role }}
                      </p>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="root-helps-testimonials__dots snap-scroll-dots">
            {% for block in section.blocks %}
              <a
                href="#testimonial-{{ block.id }}-{{ forloop.index0 }}"
                class="snap-scroll-dot root-helps-testimonials__link{% if forloop.first %} snap-scroll-dot--active{% endif %}"
                data-testimonial-index="{{ forloop.index0 }}"
              >
                <span class="visually-hidden">Go to testimonial for {{ block.settings.customer_name }}</span>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% if section.settings.show_pagination %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const section = document.getElementById('RootHelpsTestimonials-{{ section.id }}');
      const testimonials = section.querySelectorAll('.root-helps-testimonials__testimonial');
      const snapScrollDots = section.querySelectorAll('.snap-scroll-dot');
      const scrollContainer = section.querySelector('.snap-scroll');

      function updateActiveDot(testimonialIndex) {
        // Remove active class from all dots
        snapScrollDots.forEach((dot) => {
          dot.classList.remove('snap-scroll-dot--active');
        });

        // Add active class to the corresponding dot
        if (snapScrollDots[testimonialIndex]) {
          snapScrollDots[testimonialIndex].classList.add('snap-scroll-dot--active');
        }
      }

      function getCurrentTestimonialFromScroll() {
        if (!scrollContainer) return 0;

        const scrollLeft = scrollContainer.scrollLeft;
        const containerWidth = scrollContainer.clientWidth;
        let currentTestimonialIndex = 0;
        let maxVisibility = 0;

        testimonials.forEach((testimonial, index) => {
          const testimonialLeft = testimonial.offsetLeft;
          const testimonialWidth = testimonial.offsetWidth;
          const testimonialRight = testimonialLeft + testimonialWidth;

          // Calculate how much of this testimonial is visible
          const visibleLeft = Math.max(scrollLeft, testimonialLeft);
          const visibleRight = Math.min(scrollLeft + containerWidth, testimonialRight);
          const visibleWidth = Math.max(0, visibleRight - visibleLeft);
          const visibilityPercentage = visibleWidth / testimonialWidth;

          if (visibilityPercentage > maxVisibility) {
            maxVisibility = visibilityPercentage;
            currentTestimonialIndex = index;
          }
        });

        return currentTestimonialIndex;
      }

      // Add scroll listener to sync dots with swipe navigation
      if (scrollContainer) {
        let scrollTimeout;
        scrollContainer.addEventListener('scroll', function() {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            const currentTestimonial = getCurrentTestimonialFromScroll();
            updateActiveDot(currentTestimonial);
          }, 50);
        });
      }

      // Listen for clicks on snap-scroll dots to update active state
      snapScrollDots.forEach((dot) => {
        dot.addEventListener('click', function() {
          const testimonialIndex = parseInt(this.getAttribute('data-testimonial-index'));
          // Delay the active state update to allow the scroll to happen first
          setTimeout(() => {
            updateActiveDot(testimonialIndex);
          }, 100);
        });
      });

      // Initialize first dot as active
      updateActiveDot(0);
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Root Helps Testimonial",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "HOW OTHERS ARE THRIVING ON ROOT"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true,
      "info": "Show pagination when more than 3 testimonials"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#FE9A68"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Customer name color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Customer role color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Pagination dot color",
      "default": "#D9D9D9"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot color",
      "default": "#FE9A68"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Customer Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testimonial quote",
          "default": "This product has been amazing for my family!"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Sarah"
        },
        {

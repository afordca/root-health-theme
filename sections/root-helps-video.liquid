{% comment %}
  Root Helps - Video Section
  Video player with placeholder and play functionality
{% endcomment %}

{{ 'section-root-helps-video.css' | asset_url | stylesheet_tag }}

<section
  class="section-root-helps-video color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="video__container">
    <div class="video__wrapper" id="video-wrapper-{{ section.id }}">
      {%- if section.settings.video_url != blank -%}
        <div class="video__placeholder" id="video-placeholder-{{ section.id }}">
          <button
            class="video__play-button"
            type="button"
            aria-label="Play video"
            onclick="playVideo('{{ section.id }}', '{{ section.settings.video_url | escape }}')"
          >
          </button>
        </div>
      {%- else -%}
        <div class="video__placeholder">
          <div class="video__play-button"></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  function playVideo(sectionId, videoUrl) {
    const wrapper = document.getElementById('video-wrapper-' + sectionId);
    const placeholder = document.getElementById('video-placeholder-' + sectionId);

    if (!wrapper || !placeholder) return;

    // Create iframe for video
    const iframe = document.createElement('iframe');
    iframe.className = 'video__iframe';
    iframe.src = getEmbedUrl(videoUrl);
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;

    // Add iframe and hide placeholder
    wrapper.appendChild(iframe);
    wrapper.classList.add('playing');
  }

  function getEmbedUrl(url) {
    // YouTube URL conversion
    if (url.includes('youtube.com/watch?v=')) {
      const videoId = url.split('v=')[1].split('&')[0];
      return `https://www.youtube.com/embed/${videoId}?autoplay=1`;
    }

    // YouTube short URL conversion
    if (url.includes('youtu.be/')) {
      const videoId = url.split('youtu.be/')[1].split('?')[0];
      return `https://www.youtube.com/embed/${videoId}?autoplay=1`;
    }

    // Vimeo URL conversion
    if (url.includes('vimeo.com/')) {
      const videoId = url.split('vimeo.com/')[1].split('?')[0];
      return `https://player.vimeo.com/video/${videoId}?autoplay=1`;
    }

    // Return original URL if no conversion needed
    return url;
  }
</script>

{% schema %}
{
  "name": "Root Helps Video",
  "tag": "section",
  "class": "section-root-helps-video",
  "settings": [
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL",
      "info": "Supports YouTube and Vimeo URLs"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Root Helps Video",
      "settings": {}
    }
  ]
}
{% endschema %}

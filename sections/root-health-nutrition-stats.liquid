{{ 'section-nutrition-stats.css' | asset_url | stylesheet_tag }}

<section
  class="root-health-section nutrition-stats"
  id="NutritionStats-{{ section.id }}"
  style="
    --nutrition-stats-header-color: {{ section.settings.header_color | default: '#000000' }};
    --nutrition-stats-number-color: {{ section.settings.number_color | default: '#E5653D' }};
    --nutrition-stats-title-color: {{ section.settings.title_color | default: '#000000' }};
    --nutrition-stats-text-color: {{ section.settings.text_color | default: '#000000' }};
    --nutrition-stats-background-color: {{ section.settings.background_color | default: '#FFFFFF' }};
    --nutrition-stats-padding-top: {{ section.settings.padding_top | default: 36 }}px;
    --nutrition-stats-padding-bottom: {{ section.settings.padding_bottom | default: 36 }}px;
  "
>
  <div class="root-health-section__container">
    <div class="nutrition-stats__container">
      {% if section.settings.header != blank %}
        <div class="nutrition-stats__header type-label">{{ section.settings.header }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="nutrition-stats__grid">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'stat' %}
                <div class="nutrition-stats__item" {{ block.shopify_attributes }}>
                  {% if block.settings.number != blank %}
                    {%- assign ns_num = block.settings.number -%}
                    {%- assign ns_len = ns_num | size -%}
                    {%- assign ns_lenm1 = ns_len | minus: 1 -%}
                    {%- assign ns_last = ns_num | slice: -1 -%}
                    {%- assign ns_digits = '0123456789' -%}
                    {% if ns_digits contains ns_last %}
                      <div class="nutrition-stats__number">{{ ns_num }}</div>
                    {% else %}
                      {%- assign ns_prefix = ns_num | slice: 0, ns_lenm1 -%}
                      <div class="nutrition-stats__number">{{ ns_prefix }}<span class="nutrition-stats__number-unit">{{ ns_last }}</span></div>
                    {% endif %}
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <h3 class="nutrition-stats__title">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="nutrition-stats__description">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.show_divider %}
        <div class="nutrition-stats__divider" aria-hidden="true"></div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Health Nutrition",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "header",
      "default": "BY THE NUMBERS",
      "label": "Header text"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": true,
      "label": "Show bottom divider"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_color",
      "default": "#000000",
      "label": "Header color"
    },
    {
      "type": "color",
      "id": "number_color",
      "default": "#E5653D",
      "label": "Number color"
    },
    {
      "type": "color",
      "id": "title_color",
      "default": "#000000",
      "label": "Title color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#000000",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#FFFFFF",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 108,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 108,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Nutrition Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Stat number",
          "default": "15G"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Stat title",
          "default": "Protein"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Packed with essential protein to keep your body strong and your brain fit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Health Nutrition Stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "15G",
            "title": "Protein",
            "description": "Packed with essential protein to keep your body strong and your brain fit"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "130",
            "title": "Calories",
            "description": "Breastfeeding moms need an extra 500 calories a day to help with milk production. We help you get there."
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "24",
            "title": "Vitamins",
            "description": "Our medically derived formula makes sure you have the right vitamins to help with lactation production"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "7",
            "title": "Galactagogues",
            "description": "Our proprietary blend provides for an increase in supply"
          }
        }
      ]
    }
  ]
}
{% endschema %}

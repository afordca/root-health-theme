{% comment %}
  Root Health - Ingredient Hero Section
  Full-screen hero section with background image and overlay text
{% endcomment %}
{{ 'section-root-health-ingredient-hero.css' | asset_url | stylesheet_tag }}

<section
  class="section-root-health-ingredient-hero color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- liquid
    assign desktop_img = section.settings.background_image_desktop
    assign mobile_img = section.settings.background_image_mobile
    assign desktop_file = section.settings.background_image_desktop_filename
    assign mobile_file = section.settings.background_image_mobile_filename
  -%}
  <picture class="ingredient-hero__background">
    {%- if mobile_file != blank -%}
      <source media="(max-width: 767px)" srcset="{{ mobile_file | asset_url }}" sizes="100vw">
    {%- elsif mobile_img != blank -%}
      <source
        media="(max-width: 767px)"
        srcset="{{ mobile_img | image_url: width: 767 }} 767w,
                {{ mobile_img | image_url: width: 1534 }} 1534w"
        sizes="100vw"
      >
    {%- endif -%}

    {%- if desktop_file != blank -%}
      <img src="{{ desktop_file | asset_url }}" sizes="100vw" alt="" loading="lazy" width="" height="">
    {%- elsif desktop_img != blank -%}
      <img
        src="{{ desktop_img | image_url: width: 1440 }}"
        srcset="{{ desktop_img | image_url: width: 1440 }} 1440w,
                {{ desktop_img | image_url: width: 2880 }} 2880w"
        sizes="100vw"
        alt="{{ desktop_img.alt | escape }}"
        loading="lazy"
        width=""
        height=""
      >
    {%- elsif mobile_img != blank -%}
      <img
        src="{{ mobile_img | image_url: width: 1440 }}"
        srcset="{{ mobile_img | image_url: width: 1440 }} 1440w,
                {{ mobile_img | image_url: width: 2880 }} 2880w"
        sizes="100vw"
        alt="{{ mobile_img.alt | escape }}"
        loading="lazy"
        width=""
        height=""
      >
    {%- else -%}
      <img src="{{ 'ingredient-hero-bg-18fd29.jpg' | asset_url }}" sizes="100vw" alt="" loading="lazy" width="" height="">
    {%- endif -%}
  </picture>

  <div class="ingredient-hero__content">
    {%- if section.settings.title != blank -%}
      <h1 class="ingredient-hero__title">
        {{ section.settings.title | escape }}
      </h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="ingredient-hero__description">
        {{ section.settings.description }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Root Health Ingred H",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Desktop background image"
    },
    {
      "type": "text",
      "id": "background_image_desktop_filename",
      "label": "Desktop background image (asset filename)",
      "info": "Optional. Filename of an image in your theme assets, e.g. ingredient-hero-bg-18fd29.jpg. Overrides the image picker above."
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "background_image_mobile_filename",
      "label": "Mobile background image (asset filename)",
      "info": "Optional. Filename of an image in your theme assets. Overrides the mobile image picker above."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Root Health Ingredient Hero",
      "settings": {
        "title": "The cleanest ingredients for your little ones",
        "description": "<p>We source the highest quality ingredients from trusted suppliers around the world to create our premium formulas.</p>"
      }
    }
  ]
}
{% endschema %}

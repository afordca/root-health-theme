{{ 'section-root-health-hero.css' | asset_url | stylesheet_tag }}

{% liquid
  assign heading = section.settings.heading | default: ''
  assign subheading = section.settings.subheading | default: ''
  assign cta_text = section.settings.cta_text | default: 'SUBSCRIBE NOW'
  assign cta_url = section.settings.cta_url | default: '#'
  assign enable_button_cta = section.settings.enable_button_cta
  assign section_height = section.settings.section_height | default: 'large'
  assign overlay_opacity = section.settings.overlay_opacity | default: 0.2
  assign layout_type = section.settings.layout_type | default: 'full'
  assign text_position = section.settings.text_position | default: 'center'
  assign text_alignment = section.settings.text_alignment | default: 'left'
  assign title_color = section.settings.title_color | default: '#ffffff'
  assign subheading_color = section.settings.subheading_color | default: '#ffffff'
  assign layout_variant = section.settings.layout_variant | default: 'default'
%}

<section
  class="root-health-section root-health-hero root-health-hero--{{ section_height }} root-health-hero--{{ layout_type }} root-health-hero--text-{{ text_alignment }} root-health-hero--align-{{ text_position }}{% if layout_variant != 'default' %} root-health-hero--{{ layout_variant }}{% endif %}"
  id="Hero-{{ section.id }}"
>
  <div
    class="root-health-section__container"
  >
    <div
      class="root-health-hero__container"
      role="img"
      aria-label="{{ heading | escape }}"
      style="{% if section.settings.background_image_filename != blank %}background-image: url('{{ section.settings.background_image_filename | asset_url }}');{% elsif section.settings.background_image %}background-image: url('{{ section.settings.background_image | image_url: width: 1440, height: 950 }}');{% else %}--hero-bg-image: url('{{ 'hero-background-1a3f08.jpg' | asset_url }}');{% endif %}{% if section.settings.mobile_background_image %} --mobile-bg-image: url('{{ section.settings.mobile_background_image | image_url: width: 768, height: 800 }}');{% endif %} --overlay-opacity: {{ overlay_opacity }}; --hero-title-color: {{ title_color }}; --hero-subheading-color: {{ subheading_color }};"
    >
      {% if layout_type == 'split' %}
        <div class="root-health-hero__split-container">
          <div class="root-health-hero__content-side">
            <div class="root-health-hero__content">
              {% if heading != blank %}
                <h1 class="root-health-hero__heading">{{ heading }}</h1>
              {% endif %}

              <div class="root-health-hero__bottom-row desktop">
                {% if subheading != blank %}
                  <p class="root-health-hero__subheading">{{ subheading }}</p>
                {% endif %}

                {% if enable_button_cta == true and cta_text != blank and cta_url != blank %}
                  <div class="root-health-hero__cta">
                    <a href="{{ cta_url }}" class="root-health-hero__button btn btn--primary">
                      {{ cta_text }}
                    </a>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% else %}
        <div class="root-health-hero__content">
          {% if heading != blank %}
            <h1 class="root-health-hero__heading">{{ heading }}</h1>
          {% endif %}

          <div class="root-health-hero__bottom-row">
            {% if subheading != blank %}
              <p class="root-health-hero__subheading">{{ subheading }}</p>
            {% endif %}

            {% if enable_button_cta == true and cta_text != blank and cta_url != blank %}
              <div class="root-health-hero__cta">
                <a href="{{ cta_url }}" class="root-health-hero__button btn btn--primary">
                  {{ cta_text }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="root-health-hero__bottom-row mobile">
      {% if subheading != blank %}
        <p class="root-health-hero__subheading">{{ subheading }}</p>
      {% endif %}

      {% if enable_button_cta == true and cta_text != blank and cta_url != blank %}
        <div class="root-health-hero__cta">
          <button class="root-health-hero__button btn btn--primary">
            <a href="{{ cta_url }}">
              {{ cta_text }}
            </a>
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Health Hero",
  "tag": "section",
  "class": "section section-root-health-hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_variant",
      "label": "Layout variant",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "why",
          "label": "Why page (bottom-left heading)"
        }
      ],
      "default": "default",
      "info": "Use 'Why page' for a full-bleed image with the heading anchored bottom-left."
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout type",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "split",
          "label": "Split (50/50)"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Content position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "info": "Controls how text content is aligned within its container"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "SUBSCRIBE NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "enable_button_cta",
      "label": "Enable Button CTA",
      "default": true,
      "info": "Show or hide the call-to-action button"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Recommended size: 1440x950px"
    },
    {
      "type": "text",
      "id": "background_image_filename",
      "label": "Background image (asset filename)",
      "info": "Optional. Filename of an image in your theme assets, e.g. hero-home.jpg. Overrides the image picker above."
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image",
      "info": "Recommended size: 768x800px. If not set, desktop image will be used."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.2,
      "info": "Adjusts the darkness of the overlay on the background image"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        {
          "value": "small",
          "label": "Small (500px)"
        },
        {
          "value": "medium",
          "label": "Medium (650px)"
        },
        {
          "value": "large",
          "label": "Large (950px)"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ],
      "default": "large"
    }
  ],
  "presets": [
    {
      "name": "Root Health Hero"
    }
  ]
}
{% endschema %}

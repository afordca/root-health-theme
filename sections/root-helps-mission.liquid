{{ 'section-root-helps-mission.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign mission_text = section.settings.mission_text
  assign title_color = section.settings.title_color
  assign text_color = section.settings.text_color
  assign container_bg_image_mobile = section.settings.container_background_image_mobile | default: 'mission-background-default.jpg'
  assign container_bg_image_desktop = section.settings.container_background_image_desktop | default: 'mission-background-default.jpg'
-%}

<section
  class="root-helps-section root-helps-mission"
  id="section-{{ section.id }}"
  style="
    {%- if title_color != blank -%}--mission-title-color: {{ title_color }};{%- endif -%}
    {%- if text_color != blank -%}--mission-text-color: {{ text_color }};{%- endif -%}
    {%- if container_bg_image_mobile != blank -%}--mission-container-background-image-mobile: url('{{ container_bg_image_mobile | asset }}');{%- endif -%}
    {%- if container_bg_image_desktop != blank -%}--mission-container-background-image-desktop: url('{{ container_bg_image_desktop | asset }}');{%- endif -%}
  "
>
  <div class="root-helps-section__container root-helps-mission__container">
    <div class="root-helps-mission__content">
      {%- if heading != blank -%}
        <h2 class="root-helps-mission__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if mission_text != blank -%}
        <div class="root-helps-mission__text">{{ mission_text | newline_to_br }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Helps Mission",
  "tag": "section",
  "class": "section-root-helps-mission",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission Statement"
    },
    {
      "type": "header",
      "content": "Style Settings"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#e5653d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "container_background_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "image_picker",
      "id": "container_background_image_desktop",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Root Helps Mission",
      "settings": {
        "heading": "Mission",
        "mission_text": "Our mission is to alleviate the physical and emotional burdens that come with being a new mom. We strive to provide nutritionally balanced products that increase energy levels and reduce stress for new moms, allowing them to better care for themselves and their babies."
      }
    }
  ]
}
{% endschema %}

{{ 'section-root-health-product-testing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign subtitle = section.settings.subtitle
  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
  assign bg_image = section.settings.background_image
  assign bg_image_filename = section.settings.background_image_filename
-%}

<section
  class="root-health-section root-health-product-testing section-{{ section.id }}-padding"
  id="section-{{ section.id }}"
>
  <div class="root-health-section__container">
    <div class="root-health-product-testing__wrapper">
      <!-- Left Column: Image -->
      <div class="root-health-product-testing__image-container">
        {%- if bg_image_filename != blank -%}
          <img
            class="root-health-product-testing__image"
            src="{{ bg_image_filename | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="600"
            height="480"
          >
        {%- elsif bg_image != blank -%}
          <img
            class="root-health-product-testing__image"
            src="{{ bg_image | image_url: width: 600 }}"
            alt="{{ bg_image.alt | escape }}"
            loading="lazy"
            width="{{ bg_image.width }}"
            height="{{ bg_image.height }}"
          >
        {%- else -%}
          <img
            class="root-health-product-testing__image"
            src="{{ 'root-health-product-testing-bg-4174de.jpg' | asset_url }}"
            alt="Product testing background"
            loading="lazy"
            width="600"
            height="480"
          >
        {%- endif -%}
      </div>

      <!-- Right Column: Content -->
      <div class="root-health-product-testing__content">
        {%- if heading != blank -%}
          <h2 class="root-health-product-testing__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subtitle != blank -%}
          <p class="root-health-product-testing__subtitle">{{ subtitle }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="root-health-product-testing__grid">
            <div class="root-health-product-testing__grid-headers">
              <div class="root-health-product-testing__grid-header type-label">TEST</div>
              <div class="root-health-product-testing__grid-header root-health-product-testing__grid-header--tolerance type-label">
                TOLERANCE
              </div>
            </div>

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'test_item' -%}
                  <div class="root-health-product-testing__test-row" {{ block.shopify_attributes }}>
                    <div class="root-health-product-testing__test-name">
                      <div class="root-health-product-testing__checkmark-icon">
                        <svg width="15" height="10" viewBox="0 0 15 10" fill="none">
                          <path d="M1 5L5 9L14 1" stroke="currentColor" stroke-width="1"/>
                        </svg>
                      </div>
                      <span>{{ block.settings.test_name }}</span>
                    </div>
                    <div class="root-health-product-testing__test-value">
                      {{ block.settings.test_value }}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if button_text != blank and button_url != blank -%}
          <button class="root-health-product-testing__download-button button button--primary">
            <a href="{{ button_url }}" class="">
              {{- button_text -}}
            </a>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Root Health Testing",
  "tag": "section",
  "class": "section-root-health-product-testing",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "background_image_filename",
      "label": "Background image (asset filename)",
      "info": "Optional. Filename of an image in your theme assets, e.g. product-test.png. Overrides the image picker above."
    },
    {
      "type": "header",
      "content": "Download Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "section_height",
      "options": [
        {
          "value": "auto",
          "label": "Adapt to content"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "auto",
      "label": "Section height"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "test_item",
      "name": "Test Item",
      "settings": [
        {
          "type": "text",
          "id": "test_name",
          "label": "Test Name"
        },
        {
          "type": "text",
          "id": "test_value",
          "label": "Test Value/Tolerance"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Root Health Product Testing",
      "settings": {
        "heading": "Rigorously tested to meet our product standards",
        "subtitle": "Each batch is tested for and required to meet various thresholds:",
        "button_text": "DOWNLOAD Full REPORT",
        "button_url": "#"
      },
      "blocks": [
        {
          "type": "test_item",
          "settings": {
            "test_name": "Heavy Metals",
            "test_value": "< 10 ppm"
          }
        },
        {
          "type": "test_item",
          "settings": {
            "test_name": "Lead",
            "test_value": "< 0.5 ppm"
          }
        },
        {
          "type": "test_item",
          "settings": {
            "test_name": "Allergens",
            "test_value": "None"
          }
        },
        {
          "type": "test_item",
          "settings": {
            "test_name": "Cadmium",
            "test_value": "< 1 ppm"
          }
        },
        {
          "type": "test_item",
          "settings": {
            "test_name": "Mercury",
            "test_value": "< 0.1 ppm"
          }
        }
      ]
    }
  ]
}
{% endschema %}
